; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Flags Battle Royale"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

; Default (15ms) leaves very little headroom for the audio thread to survive
; a main-thread CPU stall without an underrun -- exactly what a burst of
; simultaneous flag-flag collisions (207-flag arena, early qualifying) can
; cause. An underrun during a stall is what makes some sounds actually
; reach the speaker late, arriving during what looks like a quiet moment
; afterward, even though AudioManager's own cooldown correctly DROPS excess
; play() requests rather than queuing them -- confirmed by reading that
; code, not guessed at; the delay isn't from game logic. More buffer
; headroom trades a few extra milliseconds of fixed latency (imperceptible
; for a collision clack) for a lot more resilience against exactly this.
driver/output_latency=60

[autoload]

RoyaleSettings="*res://scripts/autoload/RoyaleSettings.gd"
FlagDatabase="*res://scripts/autoload/FlagDatabase.gd"
TournamentLog="*res://scripts/autoload/TournamentLog.gd"
GameManager="*res://scripts/autoload/GameManager.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/initial_position_type=0
window/size/initial_position=Vector2i(0, 45)
window/size/resizable=false
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=120
2d/default_gravity=0
common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.070588, 0.035294, 0.121569, 1)
